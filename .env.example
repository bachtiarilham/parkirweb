# ==============================================================================
# ENVIRONMENT TEMPLATE - WEB PARKIR (SVELTEKIT)
# Salin file ini menjadi .env sebelum menjalankan aplikasi
# ==============================================================================

# Environment Mode: development | production | test
NODE_ENV=development

# Backend Server Connection (Private BFF Server-to-Server)
# Dev: http://localhost:8080 | Prod: http://127.0.0.1:8080 atau URL internal backend
BACKEND_API_URL=http://localhost:8080

# Public API URL (Hanya jika diakses langsung dari browser)
PUBLIC_API_URL=http://localhost:8080

# Server Node Adapter
PORT=3000
HOST=127.0.0.1
# ORIGIN=https://parkir.example.com
